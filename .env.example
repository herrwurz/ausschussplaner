# Kopiere zu .env und passe an
APP_NAME=AusschussPlaner API
DEBUG=false
DATABASE_URL=sqlite:///./ausschussplaner.db

# JWT-Secret — in Produktion PFLICHT (z.B. mit `openssl rand -hex 32` erzeugen)
# SECRET_KEY=

# Admin-Bootstrap: wenn ADMIN_PASSWORD gesetzt ist, wird der Admin-User
# beim Start angelegt bzw. sein Passwort gesetzt
# ADMIN_EMAIL=admin@ausschussplaner.local
# ADMIN_PASSWORD=

# CORS (JSON-Liste; nur nötig, wenn das Frontend NICHT same-origin läuft)
# CORS_ORIGINS=["http://localhost:5173"]

# Standard-Quoren
QUORUM_STANDARD=4
QUORUM_POLY=2
QUORUM_KONTROLL=3
PLANNING_WEEKS=2
